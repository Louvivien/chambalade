{
  "name": "chambalade",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "photos": "node scripts/convertir-photos.mjs",
    "astro": "astro",
    "test": "vitest run",
    "audit:todos": "node scripts/audit-todos.mjs",
    "audit:liens": "node scripts/audit-liens.mjs",
    "build:audit": "ASTRO_AUDIT=1 astro build --outDir .audit/dist",
    "dev:audit": "ASTRO_AUDIT=1 astro dev",
    "audit:front": "node scripts/audit-front.mjs",
    "audit:accueil": "node scripts/audit-accueil.mjs",
    "audit:gite": "node scripts/audit-gite.mjs",
    "audit:lieu": "node scripts/audit-lieu.mjs",
    "audit:langues": "node scripts/audit-langues.mjs",
    "audit:legal": "node scripts/audit-legal.mjs",
    "audit:reserver": "node scripts/audit-reserver.mjs",
    "audit:admin": "node scripts/audit-admin.mjs",
    "api:migrer": "npx --yes wrangler@4.156.1 d1 migrations apply chambalade --local",
    "api:demo": "npx --yes wrangler@4.156.1 d1 execute chambalade --local --file=seed/demo.sql",
    "api:dev": "npm run config:generer && astro build && npx --yes wrangler@4.156.1 pages dev",
    "deploiement:verifier": "node scripts/verifier-deploiement.mjs",
    "rgpd": "node scripts/rgpd.mjs",
    "config:generer": "node scripts/generer-config.mjs",
    "config:verifier": "node scripts/generer-config.mjs --verifier"
  },
  "dependencies": {
    "@fontsource/lora": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "astro": "^7.4.12",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "cheerio": "^1.2.0",
    "lighthouse": "^13.6.0",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
