---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  desktop: { src: ImageMetadata; alt: string };
  mobile: { src: ImageMetadata; alt: string };
}
const { desktop, mobile } = Astro.props;
const sources = await Promise.all(
  ([mobile, desktop]).flatMap((photo, index) =>
    (['avif', 'webp', 'jpeg'] as const).map(async format => {
      const widths = index === 0 ? [375, 750, 1125] : [768, 1280, 1920];
      const variants = await Promise.all(widths.map(width => getImage({ src: photo.src, width, format, quality: 65 })));
      return {
        media: index === 0 ? '(width < 48rem)' : '(width >= 48rem)',
        type: `image/${format}`,
        srcset: variants.map((variant, i) => `${variant.src} ${widths[i]}w`).join(', '),
      };
    }),
  ),
);
---
<div class="bandeau-photo">
  <picture aria-hidden="true">
    {sources.map(source => <source {...source} sizes="100vw" />)}
    <Image src={desktop.src} width={1280} alt="" loading="eager" fetchpriority="high" quality={65} />
  </picture>
  <!-- Descriptions adaptées en CSS, comme les sources : une seule dans l’arbre
       d’accessibilité, y compris sans JavaScript et après redimensionnement. -->
  <span class="photo-description description-mobile" role="img" aria-label={mobile.alt}></span>
  <span class="photo-description description-desktop" role="img" aria-label={desktop.alt}></span>
</div>
<style>
  .bandeau-photo { position: relative; }
  picture, picture :global(img) { display: block; width: 100%; }
  picture :global(img) { aspect-ratio: 3 / 4; object-fit: cover; }
  .photo-description { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .description-desktop { display: none; }
  @media (min-width: 48rem) {
    picture :global(img) { aspect-ratio: 2048 / 1178; filter: saturate(.9); }
    .description-mobile { display: none; }
    .description-desktop { display: block; }
  }
  @media (min-width: 64rem) {
    .bandeau-photo, picture { height: 100%; }
    picture :global(img) { height: 100%; object-position: center bottom; }
  }
</style>
