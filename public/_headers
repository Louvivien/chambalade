# En-têtes des pages statiques (Cloudflare Pages). Les réponses des fonctions (/api/, /admin/) posent les leurs.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Les fichiers de /_astro/ portent une empreinte dans leur nom : ils ne changent jamais.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
